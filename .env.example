NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Agent providers
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
AI_PRIMARY_PROVIDER=your_primary_provider
AI_FALLBACK_PROVIDER=your_fallback_provider
AI_GEMINI_MODEL=your_gemini_model

# WhatsApp Playwright worker shared secret
WHATSAPP_WORKER_SECRET=your_whatsapp_worker_secret

# Call recordings are supplied by an approved external capture layer.
# WhatsApp Web itself does not expose a reliable call audio stream to this worker.
CALL_RECORDING_ENABLED=true
CALL_RECORDING_PROVIDER=external_capture
CALL_RECORDING_BUCKET=call-recordings
# Secret for a future approved/native capture provider to post call lifecycle events.
CALL_RECORDING_WEBHOOK_SECRET=your_call_recording_webhook_secret
# Optional secret for a scheduler/provider to retry queued call processing.
CALL_PROCESSING_SECRET=your_call_processing_secret

# ── WhatsApp Business Cloud API (optional transport) ──
# Preferred: configure via Admin → Settings → AI Agent → WhatsApp Connection
# (stored server-side in whatsapp_transport_config; the token is NEVER exposed).
# These env values act as first-run fallbacks only.
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=your_cloud_phone_number_id
# WHATSAPP_CLOUD_ACCESS_TOKEN=your_cloud_access_token
# WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
# Optional: enables X-Hub-Signature-256 webhook validation when set.
# META_APP_SECRET=your_meta_app_secret

# How long (minutes) a WhatsApp conversation may stay in 'processing' before
# it is recovered automatically. Default: 5.
AI_CONVERSATION_LOCK_TIMEOUT_MINUTES=5

# Public site URL (used in login credentials messages)
NEXT_PUBLIC_SITE_URL=your_public_site_url
